DOMAIN=type.example.uz
TZ=Asia/Tashkent
NEXTAUTH_URL=https://type.example.uz
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
PASSWORD_ENCRYPTION_KEY=replace-with-an-independent-32-character-secret
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
DEPLOYMENT_VERSION=2026-09-29-1

POSTGRES_DB=nova_type
POSTGRES_USER=nova_type
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://nova_type:replace-with-a-strong-database-password@db:5432/nova_type?schema=public

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
